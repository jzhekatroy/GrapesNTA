# Copy to deploy/worker/.env on the CH host (same values as UI + rollups).
# network_mode: host → ClickHouse on 127.0.0.1 (native 9000, HTTP 8123).

# --- Observations (Node analytics loop) ---
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=ui_admin
CLICKHOUSE_PASSWORD=
CLICKHOUSE_READ_USER=ui_read
CLICKHOUSE_READ_PASSWORD=
CLICKHOUSE_WRITE_USER=ui_admin
CLICKHOUSE_WRITE_PASSWORD=
CLICKHOUSE_FLOWS_TABLE=flows_raw
CLICKHOUSE_FLOWS_RAW_TABLE=flows_raw
CLICKHOUSE_REQUEST_TIMEOUT_MS=120000

CH_COL_TIME=time_received_ns
CH_COL_BYTES=bytes
CH_COL_PACKETS=packets
CH_COL_SRC_IP=src_addr
CH_COL_DST_IP=dst_addr
CH_COL_SRC_PORT=src_port
CH_COL_DST_PORT=dst_port
CH_COL_PROTO=proto
CH_COL_SRC_ASN=src_asn
CH_COL_DST_ASN=dst_asn
CH_COL_SRC_COUNTRY=-
CH_COL_DST_COUNTRY=-
CH_COL_SOURCE_ID=source_id
CH_COL_DIRECTION=direction
CH_COL_ETYPE=etype
CH_COL_SAMPLER_ADDRESS=sampler_address
CH_COL_IN_IF=in_if
CH_COL_OUT_IF=out_if
CH_COL_SRC_LABEL=src_label
CH_COL_DST_LABEL=dst_label
CH_COL_SRC_ENDPOINT_SCOPE=src_endpoint_scope
CH_COL_DST_ENDPOINT_SCOPE=dst_endpoint_scope
CH_COL_SRC_NETWORK_NAME=src_network_name
CH_COL_DST_NETWORK_NAME=dst_network_name

GRAPES_ANALYTICS_WORKER=1
ANALYTICS_REPORT_CHECK_SEC=3600
OBSERVATION_ROLLUP_CONCURRENCY=1
OBSERVATION_ROLLUP_SHOT_MINUTES=15

# --- Traffic rollups (Python, native protocol) ---
TRAFFIC_ROLLUP_CH_HOST=127.0.0.1
TRAFFIC_ROLLUP_CH_PORT=9000
TRAFFIC_ROLLUP_CH_USER=ui_admin
TRAFFIC_ROLLUP_CH_PASSWORD=
TRAFFIC_ROLLUP_CH_DATABASE=default
TRAFFIC_ROLLUP_CLICKHOUSE_CLIENT=clickhouse-client
TRAFFIC_ROLLUP_LOG_FILE=/var/log/grapesnta/traffic_rollups.log
TRAFFIC_ROLLUP_MAX_BUCKETS_PER_JOB=5
TRAFFIC_ROLLUP_SAFETY_LAG_MINUTES=5
TRAFFIC_ROLLUP_MAX_RAW_LAG_SECONDS=120
TRAFFIC_ROLLUP_BOOTSTRAP_DAYS=7

# Talkers override (optional; default 15 in cron-traffic-talkers.sh)
TRAFFIC_TALKERS_MAX_BUCKETS_PER_JOB=15

# Host paths (docker compose volumes)
WORKER_DATA_DIR=./data
WORKER_LOG_DIR=./logs
