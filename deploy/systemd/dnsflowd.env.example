# Copy to `/etc/dnsflowd/dnsflowd.env` (e.g. on `netflow`).
#
#   sudo mkdir -p /etc/dnsflowd
#   sudo cp deploy/systemd/dnsflowd.env.example /etc/dnsflowd/dnsflowd.env
#   sudo chmod 0600 /etc/dnsflowd/dnsflowd.env
#
# Requires xdpflowd with XDP_DNS_PASSTHROUGH=1 on the same IFACE.

REPO_ROOT=/opt/GrapesNTA
DNSFLOWD_BIN=${REPO_ROOT}/bin/dnsflowd

IFACE=enp5s0d1

DNS_CH_DSN=
DNS_CH_TABLE=default.dns_log
DNS_CH_ANSWERS_TABLE=default.dns_answers
DNS_CH_BATCH_SIZE=5000
DNS_CH_FLUSH_INTERVAL=1s
DNS_CH_QUEUE_SIZE=262144
DNS_CH_SAMPLER_ADDR=127.0.0.1

DNS_INTERVAL=5s
DNS_HEALTH_INTERVAL=1m
DNS_HEALTH_LAG_THRESHOLD=100000
