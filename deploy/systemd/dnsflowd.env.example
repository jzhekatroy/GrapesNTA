# Copy to `/etc/dnsflowd/dnsflowd.env` (e.g. on `netflow`).
#
#   sudo mkdir -p /etc/dnsflowd
#   sudo cp deploy/systemd/dnsflowd.env.example /etc/dnsflowd/dnsflowd.env
#   sudo chmod 0600 /etc/dnsflowd/dnsflowd.env
#
# Requires xdpflowd with XDP_DNS_PASSTHROUGH=1 on the same IFACE.

REPO_ROOT=/opt/GrapesNTA
DNSFLOWD_BIN=${REPO_ROOT}/bin/dnsflowd

# --- Go runtime GC tuning ---------------------------------------------------
# Same rationale as xdpflowd: cut Go GC frequency on the DNS ingest hot path.
# Sourced by dnsflowd-exec.sh (set -a). GOMEMLIMIT is a soft cap against OOM.
# Verify: cat /proc/$(pgrep -x dnsflowd)/environ | tr '\0' '\n' | grep GO
GOGC=400
GOMEMLIMIT=8GiB

IFACE=enp5s0d1

# Logical observation point written to dns_log/dns_answers.source_id.
# DNSFLOWD_SOURCE_ID=dns-core-mirror-1

DNS_CH_DSN=
DNS_CH_TABLE=default.dns_log
DNS_CH_ANSWERS_TABLE=default.dns_answers

# Split sinks: raw dns_log and dns_answers for Flow Explorer enrichment.
DNS_CH_RAW_ENABLED=1
DNS_CH_ANSWERS_ENABLED=1
DNS_CH_RAW_BATCH_SIZE=20000
DNS_CH_ANSWERS_BATCH_SIZE=20000
DNS_CH_RAW_QUEUE_SIZE=65536
DNS_CH_ANSWERS_QUEUE_SIZE=262144
DNS_CH_RAW_WRITERS=1
DNS_CH_ANSWERS_WRITERS=2

# Legacy fallbacks (used when raw/answers batch or raw queue size is 0).
DNS_CH_BATCH_SIZE=5000
DNS_CH_QUEUE_SIZE=262144
DNS_CH_FLUSH_INTERVAL=1s
DNS_CH_SAMPLER_ADDR=127.0.0.1

DNS_CAPTURE_BATCH_SIZE=1000
DNS_CAPTURE_FLUSH_INTERVAL=100ms

DNS_INTERVAL=5s
DNS_HEALTH_INTERVAL=1m
DNS_HEALTH_LAG_THRESHOLD=100000

# Auto raw shed: pause dns_log when answers lag is high (best-effort raw policy).
DNS_CH_RAW_AUTO_SHED_ON_ANSWERS_LAG=1
DNS_CH_ANSWERS_LAG_SHED_THRESHOLD=100000
DNS_CH_ANSWERS_LAG_RECOVER_THRESHOLD=50000
DNS_CH_RAW_SHED_RECOVER_COOLDOWN=2m
DNS_CH_ANSWERS_DEDUP_TTL=60s

# UI-first overload mode (disable raw audit log, keep answers fresh):
# DNS_CH_RAW_ENABLED=0
# DNS_CH_ANSWERS_ENABLED=1
# DNS_CH_ANSWERS_WRITERS=4
