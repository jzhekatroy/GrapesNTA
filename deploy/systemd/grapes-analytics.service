[Unit]
Description=Grapes NTA observations analytics worker (rollup + reports)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/GrapesNTA/deploy/analytics
EnvironmentFile=-/etc/grapesnta/grapes-analytics.env
EnvironmentFile=-/opt/GrapesNTA/deploy/analytics/.env
Environment=GRAPES_ANALYTICS_WORKER=1
ExecStart=/usr/bin/node server/analytics.js loop
Restart=always
RestartSec=10
User=root
Group=root

[Install]
WantedBy=multi-user.target
