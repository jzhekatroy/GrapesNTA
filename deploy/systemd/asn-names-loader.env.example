## Copy to /etc/asn-names-loader/asn-names-loader.env and adjust.
## Permissions: chmod 0600 /etc/asn-names-loader/asn-names-loader.env

## Optional: path to clickhouse-client (default: /usr/bin/clickhouse-client)
# ASNNAMES_CLICKHOUSE_CLIENT=/usr/bin/clickhouse-client

## ClickHouse connection.
##
## IMPORTANT: pick credentials as a coherent tuple. The loader resolves the
## whole {host, port, user, password, database} set from the FIRST prefix it
## finds defined in the environment:
##   1. ASNNAMES_CH_*  (this file)
##   2. GEOLOADERD_CH_*  (only if no ASNNAMES_CH_* is defined)
##   3. built-in defaults (localhost:9000, user=default, empty password)
##
## So either set all five values explicitly here, or leave them ALL commented
## out to inherit from a sibling EnvironmentFile / built-in defaults. Mixing
## (e.g. setting USER here without PASSWORD) leads to authentication errors.

# ASNNAMES_CH_HOST=127.0.0.1
# ASNNAMES_CH_PORT=9000
# ASNNAMES_CH_USER=default
# ASNNAMES_CH_PASSWORD=
# ASNNAMES_CH_DATABASE=default

## Source: where the list of ASN to enrich is read from. asn_registry is the
## RIR-derived list (~120k ASN). Set --source-filter or override the table to
## restrict the working set, e.g. to ASN that actually appear in BGP/traffic.
ASNNAMES_SOURCE_TABLE=default.asn_registry
# ASNNAMES_SOURCE_FILTER=

## Target table (ReplacingMergeTree by updated_at).
ASNNAMES_CH_TABLE=default.asn_names

## Team Cymru bulk whois — public, no auth.
## See https://team-cymru.com/community-services/ip-asn-mapping/
ASNNAMES_CYMRU_HOST=whois.cymru.com
ASNNAMES_CYMRU_PORT=43
ASNNAMES_CYMRU_TIMEOUT=120
ASNNAMES_CHUNK_SIZE=5000

## Refuse to insert if fewer rows parsed (guards against silent network failure).
ASNNAMES_MIN_ROWS=1000

## Optional progress logging to stderr (journalctl friendly).
# ASNNAMES_PROGRESS=1
