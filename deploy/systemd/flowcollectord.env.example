# Copy to `/etc/flowcollectord/flowcollectord.env` on the sFlow collector host.
#
#   sudo mkdir -p /etc/flowcollectord
#   sudo cp deploy/systemd/flowcollectord.env.example /etc/flowcollectord/flowcollectord.env
#   sudo chmod 0600 /etc/flowcollectord/flowcollectord.env

REPO_ROOT=/opt/GrapesNTA
FLOWCOLLECTORD_BIN=${REPO_ROOT}/bin/flowcollectord

# sFlow v5 listener (disable on hosts that only run NetFlow later).
FC_SFLOW_ENABLED=1
FC_SFLOW_LISTEN=0.0.0.0:6343
FC_SFLOW_SOURCE_ID=sflow-default

# ClickHouse — URL-encode special chars in password.
FC_CH_DSN=clickhouse://USER:PASS@HOST:9000/default
FC_CH_TABLE=default.flows_raw
FC_CH_BATCH_SIZE=5000
FC_CH_FLUSH_INTERVAL=1s
FC_CH_QUEUE_SIZE=64

FC_CH_SPOOL_MODE=required
FC_CH_SPOOL_DIR=/var/lib/flowcollectord/ch-spool
FC_CH_SPOOL_SEGMENT_SIZE=268435456
FC_CH_SPOOL_MAX_BYTES=214748364800
FC_CH_SPOOL_FRAME_MAX_RECORDS=50000
FC_CH_SPOOL_FSYNC_INTERVAL=1s
FC_CH_SPOOL_SHUTDOWN_DRAIN=300s
FC_CH_SPOOL_STALL_THRESHOLD=60s
FC_CH_WRITERS=4

FC_CLASSIFIER=1
FC_CLASSIFIER_REFRESH=60s
FC_CLASSIFIER_BGP_TABLE=default.bgp_prefix_origin_current
FC_CLASSIFIER_L3_PREFIXES_VIEW=default.net_l3_prefixes_enabled
FC_CLASSIFIER_L2_VLANS_VIEW=default.net_l2_vlans_enabled
# Optional fallback public IP->ASN table. Set ONLY after creating and loading
# deploy/clickhouse/ip_asn_prefixes.sql (iptoasn-loader). Reduces remote_asn=0.
# FC_CLASSIFIER_IP_ASN_TABLE=default.ip_asn_prefixes_current

# Kernel UDP receive buffer requested via SO_RCVBUF.
# Linux clamps this to net.core.rmem_max; raise sysctl on high-rate collectors.
FC_UDP_READ_BUFFER=67108864
FC_UDP_READERS=1
FC_UDP_WORKERS=8
FC_UDP_QUEUE_SIZE=65536
FC_INTERVAL=5s
FC_HEALTH_INTERVAL=1m
