[Unit]
Description=GrapesNTA local-networks-loader — build local_networks from local ASN
After=network-online.target bgp-origin-refresh.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/local-networks-loader/local-networks-loader.env
ExecStart=/usr/bin/python3 /opt/GrapesNTA/scripts/load_local_networks_from_asn.py

TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
