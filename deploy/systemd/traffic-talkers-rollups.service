[Unit]
Description=GrapesNTA async top talkers / pair rollups to ClickHouse
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/grapesnta/traffic-rollups.env
EnvironmentFile=-/etc/grapesnta/traffic-talkers-rollups.env
# Explicit job list: the heavy talker/pair rollups only. Must stay complete and
# disjoint from traffic-rollups.service. pair_1h MUST stay here, otherwise the
# 3h/6h/12h/24h "Pairs" tab goes stale because nothing advances it.
ExecStart=/usr/bin/python3 /opt/GrapesNTA/scripts/traffic_rollup_async.py --jobs traffic_talker_1m,traffic_talker_1h,traffic_pair_1m,traffic_pair_1h
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
