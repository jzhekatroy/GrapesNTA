[Unit]
Description=GrapesNTA async top talkers / pair rollups to ClickHouse
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/grapesnta/traffic-rollups.env
EnvironmentFile=-/etc/grapesnta/traffic-talkers-rollups.env
# ASN-only Top Talkers / Pairs (UI reads traffic_asn_* / traffic_asn_pair_*).
# Disjoint from traffic-rollups.service. asn_pair_1h MUST stay here so the
# longer Pairs ranges stay fresh.
ExecStart=/usr/bin/python3 /opt/GrapesNTA/scripts/traffic_rollup_async.py --jobs traffic_asn_1m,traffic_asn_1h,traffic_asn_pair_1m,traffic_asn_pair_1h
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
