# Copy to `/etc/bmpgrapes/bmpgrapes.env` on the BMP collector host.
#
#   sudo mkdir -p /etc/bmpgrapes
#   sudo cp deploy/systemd/bmpgrapes.env.example /etc/bmpgrapes/bmpgrapes.env
#   sudo chmod 0600 /etc/bmpgrapes/bmpgrapes.env

REPO_ROOT=/opt/GrapesNTA
BMPGRAPES_BIN=${REPO_ROOT}/bin/bmpgrapes

BMP_LISTEN=0.0.0.0:5000
BMP_CH_DSN=
BMP_CH_EVENTS_TABLE=default.bmp_route_events
BMP_CH_PEERS_TABLE=default.bmp_peers
BMP_CH_BATCH_SIZE=1000
BMP_CH_FLUSH_INTERVAL=1s
BMP_CH_QUEUE_SIZE=4096

# Optional comma-separated allowlist of router IPs.
# Empty = accept BMP from any source (only safe behind a firewall).
BMP_ALLOW_ROUTERS=

BMP_MAX_MESSAGE_BYTES=65535
BMP_INTERVAL=10s

# Logging.
#   level:  debug | info | warn | error
#   format: text | json
#   update_samples: how many BGP UPDATEs per session to log at Info level.
BMP_LOG_LEVEL=info
BMP_LOG_FORMAT=text
BMP_LOG_UPDATE_SAMPLES=10
