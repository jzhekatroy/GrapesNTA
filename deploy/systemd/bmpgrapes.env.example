# Copy to `/etc/bmpgrapes/bmpgrapes.env` on the BMP collector host.
#
#   sudo mkdir -p /etc/bmpgrapes
#   sudo cp deploy/systemd/bmpgrapes.env.example /etc/bmpgrapes/bmpgrapes.env
#   sudo chmod 0600 /etc/bmpgrapes/bmpgrapes.env

REPO_ROOT=/opt/GrapesNTA
BMPGRAPES_BIN=${REPO_ROOT}/bin/bmpgrapes

# Must match the TCP port routers use for BMP (nta uses 10179, not 5000).
# Also open that port in the host firewall for peer IPs only.
BMP_LISTEN=0.0.0.0:5000
BMP_CH_DSN=
BMP_CH_EVENTS_TABLE=default.bmp_route_events
BMP_CH_PEERS_TABLE=default.bmp_peers
BMP_CH_BATCH_SIZE=1000
BMP_CH_FLUSH_INTERVAL=1s
BMP_CH_QUEUE_SIZE=4096
# Queue overflow behaviour when ClickHouse temporarily slows down:
#   block (default) - bmpgrapes stops reading from the BMP TCP socket;
#                     TCP back-pressure makes the router slow down. No data loss.
#   drop            - bmpgrapes discards the overflow batch (legacy behaviour).
#                     Use only if you explicitly prefer dropping over slowing
#                     down the BMP session.
BMP_CH_QUEUE_MODE=block

# Optional comma-separated allowlist of router IPs (TCP source).
# Empty = accept BMP from any source (only safe behind a firewall).
BMP_ALLOW_ROUTERS=

# Optional TCP-source → canonical router_addr map (ClickHouse identity).
# Use when BMP arrives from a public/NAT IP but flows/sFlow use the loopback/internal IP.
# Format: src=canonical,src2=canonical2  (newlines and # comments allowed)
# Example:
#   BMP_ROUTER_ADDR_MAP=5.188.236.252=10.70.0.55,5.188.236.250=10.70.0.77
BMP_ROUTER_ADDR_MAP=

BMP_MAX_MESSAGE_BYTES=65535
BMP_INTERVAL=10s
BMP_HEALTH_INTERVAL=1m
BMP_HEALTH_WRITER_LAG_ROWS=100000
BMP_HEALTH_QUEUE_BLOCKS=100000
BMP_HEALTH_BGP_PARSE_ERROR_PCT=5
# Set true only after at least one router is expected to keep a BMP TCP session open.
BMP_HEALTH_REQUIRE_ACTIVE_PEER=false

# Logging.
#   level:  debug | info | warn | error
#   format: text | json
#   update_samples: how many BGP UPDATEs per session to log at Info level.
BMP_LOG_LEVEL=info
BMP_LOG_FORMAT=text
BMP_LOG_UPDATE_SAMPLES=10
