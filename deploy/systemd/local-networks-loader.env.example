# Copy to /etc/local-networks-loader/local-networks-loader.env and adjust.
# Permissions: chmod 0600 /etc/local-networks-loader/local-networks-loader.env

# Loader connection to ClickHouse (where it reads bgp_prefix_origin_current and
# writes local_networks).
LOCALNETWORKS_CH_HOST=95.215.1.30
LOCALNETWORKS_CH_PORT=6124
LOCALNETWORKS_CH_USER=develop
LOCALNETWORKS_CH_PASSWORD=
LOCALNETWORKS_CH_DATABASE=default

# Local ASN to use as the source of local prefixes.
LOCALNETWORKS_ASN=34665
LOCALNETWORKS_NAME=PINDC-AS AS34665
LOCALNETWORKS_SOURCE=bgp_origin_as34665
LOCALNETWORKS_FAMILIES=4,6

LOCALNETWORKS_ORIGIN_TABLE=default.bgp_prefix_origin_current
LOCALNETWORKS_TABLE=default.local_networks
LOCALNETWORKS_ENABLED_VIEW=default.local_networks_enabled
LOCALNETWORKS_DICT=default.local_networks_dict

# Dictionary SOURCE connection. These settings are used by ClickHouse itself
# when loading local_networks_dict. If the loader connects through an external
# endpoint, set these to the ClickHouse server's internal endpoint, commonly
# 127.0.0.1:9000 from ClickHouse's perspective.
LOCALNETWORKS_DICT_SOURCE_HOST=127.0.0.1
LOCALNETWORKS_DICT_SOURCE_PORT=9000
LOCALNETWORKS_DICT_SOURCE_USER=develop
LOCALNETWORKS_DICT_SOURCE_PASSWORD=
LOCALNETWORKS_DICT_SOURCE_DATABASE=default
LOCALNETWORKS_DICT_SOURCE_TABLE=local_networks_enabled
