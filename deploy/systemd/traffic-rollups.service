[Unit]
Description=GrapesNTA async traffic rollups to ClickHouse
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/grapesnta/traffic-rollups.env
ExecStart=/usr/bin/python3 /opt/GrapesNTA/scripts/traffic_rollup_async.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
