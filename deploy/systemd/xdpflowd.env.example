# Copy to `/etc/xdpflowd/xdpflowd.env` on the target host and fill secrets.
#
#   sudo mkdir -p /etc/xdpflowd
#   sudo cp deploy/systemd/xdpflowd.env.example /etc/xdpflowd/xdpflowd.env
#   sudo chmod 0600 /etc/xdpflowd/xdpflowd.env
#   sudoedit /etc/xdpflowd/xdpflowd.env
#
# Required for ClickHouse direct ingest:
#   XDP_CH_DSN — native protocol, e.g. clickhouse://USER:PASS@HOST:9000/default
#   XDP_CH_TABLE — e.g. default.flows_raw
#
# Optional: if your checkout is not under /opt/GrapesNTA, set REPO_ROOT.

REPO_ROOT=/opt/GrapesNTA
XDPFLOWD_BIN=${REPO_ROOT}/bin/xdpflowd

# --- Go runtime GC tuning (validated on m61) --------------------------------
# The collector hot path (flow export + spool encode) allocates heavily. At the
# default GOGC=100 the Go GC runs very often and dominated CPU (~14 cores).
# Raising GOGC lets the heap grow more between collections; GOMEMLIMIT is a soft
# cap so a ClickHouse backlog cannot OOM the host. Sourced by xdpflowd-exec.sh
# (set -a) and inherited by the process. Validated: ~14 cores -> ~3-4 cores at
# 3 Mpps. Verify with: cat /proc/$(pgrep -x xdpflowd)/environ | tr '\0' '\n' | grep GO
GOGC=800
GOMEMLIMIT=8GiB

IFACE=enp5s0d1
# Mirror NIC: disable RX VLAN offload so XDP/BPF see 802.1Q tags (src_vlan).
# tcpdump may show vlan while flows_raw has src_vlan=0 when this stays on.
XDP_MIRROR_RXVLAN_OFF=1
XDP_BPF_OBJ=${REPO_ROOT}/bpf/xdp_flow.o
XDP_MODE=generic
XDP_ACTION=drop

# When 1, UDP/53 always uses XDP_PASS on the SPAN interface so co-located
# dnsflowd (AF_PACKET) can capture DNS while other traffic stays -xdp-action drop.
XDP_DNS_PASSTHROUGH=0

# Local nfcapd only (no goflow2 fanout in permanent mode — goflow2 is stopped).
NF_DSTS=127.0.0.1:9996

# Universal conservative default, validated on sel: short export windows with
# 1s map scan. Set XDP_HEAVY_EXPORT=1 only when the host needs 500ms scan.
XDP_HEAVY_EXPORT=0
XDP_NF_ACTIVE=60s
XDP_NF_IDLE=10s
XDP_NF_TEMPLATE_INTERVAL=60s
XDP_NF_SCAN=1s

# Flow drain strategy.
#   timer = per-key idle/active drain (walks the whole map every XDP_NF_SCAN;
#           cheap on low-cardinality hosts, but on high-pps mirrors the walk
#           cannot keep up and the flow map overflows -> map_full -> lost flows).
#   batch = whole-map BPF_MAP_LOOKUP_AND_DELETE_BATCH every XDP_DRAIN_INTERVAL.
#           Orders of magnitude fewer syscalls, so the map is always drained and
#           never overflows. The drain interval becomes the effective active
#           timeout (every flow is exported once per interval).
# Production baseline: timer/atomic. It preserves NetFlow idle/active semantics
# and now streams expired flows in bounded chunks. Do NOT use batch as the
# default production mode: full-drain changes flow semantics and can overload
# ClickHouse with row amplification.
XDP_DRAIN_MODE=timer
# 0s = use XDP_NF_ACTIVE as the batch drain interval (batch mode only).
XDP_DRAIN_INTERVAL=0s
# Fast operational restarts. 0 skips "export every in-map flow" on SIGTERM.
# Set to 1 only for planned drains where slower stop is acceptable.
XDP_FINAL_FLUSH=0

# Experimental only, not a production default. Aggregation is only meaningful
# with XDP_DRAIN_MODE=batch and was kept for controlled tests. Do not enable it
# as the first response to map_full: prefer larger maps, streaming timer drain,
# and ClickHouse ingest fixes.
XDP_AGG_ENABLE=0
XDP_AGG_IDLE=15s
XDP_AGG_ACTIVE=60s
# Cap on cached flows if experimental aggregation is enabled.
XDP_AGG_MAX_ENTRIES=2000000

# Flow-loss alerting: emit a dedicated ERROR line "xdpflowd flow loss" when the
# fraction of dropped (map_full) vs total packets in a health interval exceeds
# this. 0.0001 = 0.01%. Set 0 to log on ANY non-zero loss. Grep it with:
#   journalctl -u xdpflowd | grep 'xdpflowd flow loss'
XDP_HEALTH_LOSS_RATIO=0.0001

XDP_TOP=0
XDP_INTERVAL=5s
# How often to walk the full BPF flow map for the top-N dump (expensive on
# high-cardinality hosts). Cheap PERCPU stats still print every XDP_INTERVAL.
# Set 0 to disable the top-N dump entirely and keep only the cheap stats line.
XDP_TOP_INTERVAL=60s
XDP_HEALTH_INTERVAL=1m
XDP_HEALTH_SPOOL_LAG_SEGMENTS=10
XDP_HEALTH_WRITER_LAG_ROWS=100000
XDP_HEALTH_DRAINER_AGE=2m

# JSON snapshots off by default (lower overhead).
XDP_JSON_OUT_ENABLE=0
XDP_JSON_OUT_PATH=
XDP_JSON_INTERVAL=10s

# Optional YAML merged before CLI (leave empty if unused).
XDP_CONFIG_FILE=

# ClickHouse — set DSN (URL-encode special chars in password) and table.
XDP_CH_DSN=
XDP_CH_TABLE=default.flows_raw
XDP_CH_BATCH_SIZE=500
XDP_CH_FLUSH_INTERVAL=1s
XDP_CH_QUEUE_SIZE=64
XDP_CH_SAMPLER_ADDR=127.0.0.1

# Logical observation point written to flows_raw.source_id (see net_flow_sources).
# REQUIRED: the wrapper refuses to start without it and rejects the legacy
# 'xdp-default' value (unclassified, pollutes rollups). Use a registered id.
XDPFLOWD_SOURCE_ID=netflow

# Collector-side traffic classification. Enable only after applying:
#   deploy/schema/50_net/03_net_entities.sql
#   deploy/schema/50_net/05_net_l3_prefixes.sql
#   deploy/schema/50_net/06_net_l2_vlans.sql
#   deploy/clickhouse/flows_raw_extensions.sql
XDP_CLASSIFIER=0
XDP_CLASSIFIER_REFRESH=60s
XDP_CLASSIFIER_BGP_TABLE=default.bgp_prefix_origin_current
# Optional remote ASN fallback. Enable only after applying
# deploy/schema/40_enrichment/04_ip_asn_prefixes_current.sql and loading the table.
# XDP_CLASSIFIER_IP_ASN_TABLE=default.ip_asn_prefixes_current
XDP_CLASSIFIER_L3_PREFIXES_VIEW=default.net_l3_prefixes_enabled
XDP_CLASSIFIER_L2_VLANS_VIEW=default.net_l2_vlans_enabled

# Flow exclusions. Traffic matched by an enabled rule is dropped before it
# reaches ClickHouse AND before it is encoded into NetFlow v9 — it is gone, not
# hidden. Requires deploy/schema/50_net/35_net_flow_exclusions.sql. An empty catalog
# drops nothing, so leaving this on is safe.
XDP_EXCLUSIONS=1
XDP_EXCLUSIONS_VIEW=default.net_flow_exclusions_enabled
XDP_EXCLUSIONS_REFRESH=60s

XDP_CH_SPOOL_MODE=required
XDP_CH_SPOOL_DIR=/var/lib/xdpflowd/ch-spool
XDP_CH_SPOOL_SEGMENT_SIZE=268435456
XDP_CH_SPOOL_MAX_BYTES=214748364800
XDP_CH_SPOOL_FRAME_MAX_RECORDS=50000
XDP_CH_SPOOL_FSYNC_INTERVAL=1s
# Bounded drain on SIGTERM so systemd stop flushes spool before exit.
# Spool is durable: any backlog not flushed here replays on next start, so a
# small value keeps `systemctl stop` fast. Raise (e.g. 300s) only for planned
# A/B swaps where you must flush everything before stopping.
# Drain also aborts early if drainer makes no ack progress for STALL_THRESHOLD.
XDP_CH_SPOOL_SHUTDOWN_DRAIN=30s
# Force resync past suspect frame if the durable consumer makes no progress
# for this long while spool data is available (also caps shutdown drain wait).
XDP_CH_SPOOL_STALL_THRESHOLD=60s
XDP_CH_WRITERS=8

# Periodic health snapshots for NTAdmin completeness (requires table DDL).
XDP_CH_HEALTH_TABLE=default.collector_health_snapshots
XDP_COLLECTOR_ID=sel

# Kept aligned with the validated wrapper profile; systemd mode does not run
# prod_ab_swap's watchdog, but this value documents the intended tolerance.
WATCHDOG_STALL_SEC=300

# goflow2 container stopped by prod_enable script (space-separated for rollback).
XDP_GOFLOW2_CONTAINERS=kcg-goflow2-1

# Optional: refuse to run unless `hostname -s` matches.
# XDPFLOWD_EXPECT_HOST_SHORT=sel
