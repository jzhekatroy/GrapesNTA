## Copy to /etc/iptoasn-loader/iptoasn-loader.env and adjust.
## Permissions: chmod 0600 /etc/iptoasn-loader/iptoasn-loader.env

## Optional: path to clickhouse-client (default: /usr/bin/clickhouse-client)
# IPTOASN_CLICKHOUSE_CLIENT=/usr/bin/clickhouse-client

## ClickHouse connection. Defaults can be inherited from geoloaderd.env when
## both EnvironmentFile lines are used by systemd.
# IPTOASN_CH_HOST=127.0.0.1
# IPTOASN_CH_PORT=9000
# IPTOASN_CH_USER=default
# IPTOASN_CH_PASSWORD=
# IPTOASN_CH_DATABASE=default

IPTOASN_CACHE_DIR=/var/lib/iptoasn-loader/cache
IPTOASN_URL=https://iptoasn.com/data/ip2asn-combined.tsv.gz
IPTOASN_CH_TABLE=default.ip_asn_prefixes_current
IPTOASN_CH_STAGING=default.ip_asn_prefixes_staging
IPTOASN_MIN_ROWS=100000
IPTOASN_TIMEOUT=180
