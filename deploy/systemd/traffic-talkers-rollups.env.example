# Async ASN top talkers / pair rollups (separate from lightweight dashboard rollups).
# Copy to /etc/grapesnta/traffic-talkers-rollups.env on the collector host.
#
# ClickHouse credentials can also live in /etc/grapesnta/traffic-rollups.env;
# this service loads both EnvironmentFile entries (talkers overrides rollups).
#
# Jobs: traffic_asn_1m, traffic_asn_1h, traffic_asn_pair_1m, traffic_asn_pair_1h

# TRAFFIC_ROLLUP_CH_HOST=95.215.1.30
# TRAFFIC_ROLLUP_CH_PORT=6124
# TRAFFIC_ROLLUP_CH_USER=develop
# TRAFFIC_ROLLUP_CH_PASSWORD=
# TRAFFIC_ROLLUP_CLICKHOUSE_CLIENT=/usr/local/bin/clickhouse-client

# ASN jobs are light; a few buckets per run still helps catch-up after restarts.
TRAFFIC_ROLLUP_MAX_BUCKETS_PER_JOB=3
TRAFFIC_ROLLUP_SAFETY_LAG_MINUTES=5
TRAFFIC_ROLLUP_MAX_RAW_LAG_SECONDS=120
