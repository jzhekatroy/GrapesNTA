# Copy to /etc/bgp-origin-refresh/bgp-origin-refresh.env and adjust.
# Permissions: chmod 0600 /etc/bgp-origin-refresh/bgp-origin-refresh.env

# Loader connection to ClickHouse.
BGPORIGIN_CH_HOST=95.215.1.30
BGPORIGIN_CH_PORT=6124
BGPORIGIN_CH_USER=develop
BGPORIGIN_CH_PASSWORD=
BGPORIGIN_CH_DATABASE=default

BGPORIGIN_ROUTE_EVENTS_TABLE=default.bmp_route_events
BGPORIGIN_CH_TABLE=default.bgp_prefix_origin_current
BGPORIGIN_CH_STAGING=default.bgp_prefix_origin_current_staging
BGPORIGIN_CH_DICT=default.bgp_origin_asn_dict
BGPORIGIN_LOOKBACK_DAYS=1

# Per-query ClickHouse limits. Keep max_memory_usage well below the server's
# total memory limit so the overcommit tracker does not abort the rebuild.
# External group-by spills aggregation state to disk when it grows beyond
# BGPORIGIN_MAX_BYTES_BEFORE_EXTERNAL_GROUP_BY, which must be lower than
# BGPORIGIN_MAX_MEMORY_USAGE.
BGPORIGIN_MAX_MEMORY_USAGE=4294967296
BGPORIGIN_MAX_BYTES_BEFORE_EXTERNAL_GROUP_BY=1073741824
BGPORIGIN_MAX_THREADS=2

# Dictionary SOURCE connection. These settings are used by the ClickHouse
# server itself when it loads bgp_origin_asn_dict. If the loader connects
# through an external/proxy endpoint, set these to the ClickHouse server's
# internal endpoint, commonly 127.0.0.1:9000 from ClickHouse's own perspective.
BGPORIGIN_DICT_SOURCE_HOST=127.0.0.1
BGPORIGIN_DICT_SOURCE_PORT=9000
BGPORIGIN_DICT_SOURCE_USER=develop
BGPORIGIN_DICT_SOURCE_PASSWORD=
BGPORIGIN_DICT_SOURCE_DATABASE=default
BGPORIGIN_DICT_SOURCE_TABLE=bgp_prefix_origin_current
