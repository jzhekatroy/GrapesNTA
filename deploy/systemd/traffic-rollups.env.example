# Async traffic rollups (replaces sync traffic_*_mv).
# Copy to /etc/grapesnta/traffic-rollups.env on the host that runs the timer.
#
# IMPORTANT:
# - Keep all traffic_*_mv detached while rollups are active.
# - Do NOT enable the timer until xdpflowd spool is caught up (lag_segments ~ 0).
# - During spool catch-up, rollups would compute incomplete minutes.

TRAFFIC_ROLLUP_CH_HOST=95.215.1.30
TRAFFIC_ROLLUP_CH_PORT=6124
TRAFFIC_ROLLUP_CH_USER=develop
TRAFFIC_ROLLUP_CH_PASSWORD=
TRAFFIC_ROLLUP_CH_DATABASE=default
TRAFFIC_ROLLUP_LOG_FILE=/var/log/grapesnta/traffic_rollups.log
# Optional: path to clickhouse-client (default /usr/bin/clickhouse-client, else PATH lookup)
# TRAFFIC_ROLLUP_CLICKHOUSE_CLIENT=/usr/local/bin/clickhouse-client

# Process one closed bucket per job per run.
TRAFFIC_ROLLUP_MAX_BUCKETS_PER_JOB=1
# Optional: sleep after each written bucket to reduce ClickHouse pressure.
# TRAFFIC_ROLLUP_SLEEP_BETWEEN_BUCKETS=0
# Do not rollup the most recent N minutes (late rows / spool lag).
TRAFFIC_ROLLUP_SAFETY_LAG_MINUTES=5
# Skip rollups while flows_raw is more than N seconds behind now.
TRAFFIC_ROLLUP_MAX_RAW_LAG_SECONDS=120
# First run without state starts from min(raw) but not older than N days.
TRAFFIC_ROLLUP_BOOTSTRAP_DAYS=7

# Optional: set to 1 during manual rebuild of a bucket.
# TRAFFIC_ROLLUP_DELETE_BEFORE_INSERT=0
