# Copy to deploy/enrichment/.env on the CH host.
# network_mode: host → ClickHouse native 127.0.0.1:9000

# --- geoloaderd (RIR FTP → geo_prefix_country + asn_registry) ---
GEOLOADERD_CH_HOST=127.0.0.1
GEOLOADERD_CH_PORT=9000
GEOLOADERD_CH_USER=default
GEOLOADERD_CH_PASSWORD=
GEOLOADERD_CH_DATABASE=default
GEOLOADERD_CACHE_DIR=/var/lib/geoloaderd/cache
# Forced to /usr/local/bin/clickhouse-client (HTTP shim) by cron wrappers.
GEOLOADERD_CLICKHOUSE_CLIENT=/usr/local/bin/clickhouse-client
CLICKHOUSE_HTTP_PORT=8123

GEOLOADERD_CH_TABLE=default.geo_prefix_country
GEOLOADERD_CH_STAGING=default.geo_prefix_country_staging
GEOLOADERD_CH_ASN_TABLE=default.asn_registry
GEOLOADERD_CH_ASN_STAGING=default.asn_registry_staging
GEOLOADERD_CH_DICT=default.geo_country_dict

GEOLOADERD_DICT_SOURCE_HOST=127.0.0.1
GEOLOADERD_DICT_SOURCE_PORT=9000
GEOLOADERD_DICT_SOURCE_USER=default
GEOLOADERD_DICT_SOURCE_PASSWORD=
GEOLOADERD_DICT_SOURCE_DATABASE=default
GEOLOADERD_DICT_SOURCE_TABLE=geo_prefix_country

# --- bgp-origin-refresh ---
BGPORIGIN_CH_HOST=127.0.0.1
BGPORIGIN_CH_PORT=9000
BGPORIGIN_CH_USER=ui_admin
BGPORIGIN_CH_PASSWORD=
BGPORIGIN_CH_DATABASE=default
BGPORIGIN_CLICKHOUSE_CLIENT=/usr/local/bin/clickhouse-client

BGPORIGIN_ROUTE_EVENTS_TABLE=default.bmp_route_events
BGPORIGIN_CH_TABLE=default.bgp_prefix_origin_current
BGPORIGIN_CH_STAGING=default.bgp_prefix_origin_current_staging
BGPORIGIN_CH_DICT=default.bgp_origin_asn_dict
BGPORIGIN_LOOKBACK_DAYS=14
BGPORIGIN_MIN_PREFIXES=100000
BGPORIGIN_MAX_PREFIX_DROP_PCT=50
BGPORIGIN_MAX_MEMORY_USAGE=4294967296
BGPORIGIN_MAX_BYTES_BEFORE_EXTERNAL_GROUP_BY=1073741824
BGPORIGIN_MAX_THREADS=2

BGPORIGIN_DICT_SOURCE_HOST=127.0.0.1
BGPORIGIN_DICT_SOURCE_PORT=9000
BGPORIGIN_DICT_SOURCE_USER=default
BGPORIGIN_DICT_SOURCE_PASSWORD=
BGPORIGIN_DICT_SOURCE_DATABASE=default

# --- asn-names-loader (inherits GEOLOADERD_CH_* when ASNNAMES_CH_* unset) ---
ASNNAMES_SOURCE_TABLE=default.asn_registry
ASNNAMES_CH_TABLE=default.asn_names
ASNNAMES_CYMRU_HOST=whois.cymru.com
ASNNAMES_CYMRU_PORT=43
ASNNAMES_CYMRU_TIMEOUT=120
ASNNAMES_CHUNK_SIZE=5000
ASNNAMES_MIN_ROWS=1000

# Compose volumes
ENRICHMENT_CACHE_DIR=geoloaderd-cache
ENRICHMENT_LOG_DIR=./logs
