# Сервер
PORT=3000
# Для HTTP-сервера оставьте false. Для HTTPS включите true.
SESSION_COOKIE_SECURE=false
# Включайте true, если приложение стоит за reverse proxy.
TRUST_PROXY=false

# ClickHouse (HTTP-интерфейс, порт 8123)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Отдельные пользователи для чтения и записи (опционально; по умолчанию — CLICKHOUSE_USER)
# SELECT идут через read-пользователя; INSERT/ALTER/DELETE — через write.
# CLICKHOUSE_READ_USER=grapes_read
# CLICKHOUSE_READ_PASSWORD=
# CLICKHOUSE_WRITE_USER=grapes_write
# CLICKHOUSE_WRITE_PASSWORD=
CLICKHOUSE_DATABASE=default

CLICKHOUSE_FLOWS_TABLE=flows
CLICKHOUSE_FLOWS_RAW_TABLE=flows_raw
CLICKHOUSE_DASHBOARD_TABLE=traffic_dashboard_1m
CLICKHOUSE_DASHBOARD_HOUR_TABLE=traffic_dashboard_1h
CLICKHOUSE_DASHBOARD_DAY_TABLE=traffic_dashboard_1d
CLICKHOUSE_PROTOCOL_TABLE=traffic_protocol_1m
CLICKHOUSE_SERVICE_TABLE=traffic_service_1m
CLICKHOUSE_UNKNOWN_PORT_TABLE=traffic_unknown_port_1m
CLICKHOUSE_COUNTRY_TABLE=traffic_country_1m
CLICKHOUSE_TALKER_TABLE=traffic_asn_1m
CLICKHOUSE_TALKER_TABLE_HOUR=traffic_asn_1h
CLICKHOUSE_PAIR_TABLE=traffic_asn_pair_1m
CLICKHOUSE_PAIR_TABLE_HOUR=traffic_asn_pair_1h
CLICKHOUSE_SOURCES_TABLE=net_flow_sources_enabled
CLICKHOUSE_FLOW_SOURCES_TABLE=net_flow_sources
CLICKHOUSE_COLLECTORS_VIEW=net_collectors_enabled
CLICKHOUSE_COLLECTORS_TABLE=net_collectors
CLICKHOUSE_LOCATIONS_VIEW=net_locations_enabled
CLICKHOUSE_LOCATIONS_TABLE=net_locations
CLICKHOUSE_DNS_LOG_TABLE=dns_log
CLICKHOUSE_DNS_ANSWERS_TABLE=dns_answers
CLICKHOUSE_DNS_ACTIVITY_5M_TABLE=dns_activity_5m
CLICKHOUSE_DNS_DOMAINS_1H_TABLE=dns_domains_1h
CLICKHOUSE_DNS_CLIENTS_1H_TABLE=dns_clients_1h
CLICKHOUSE_DNS_SERVERS_1H_TABLE=dns_servers_1h
CLICKHOUSE_DNS_RESOLVERS_TABLE=net_dns_resolvers
CLICKHOUSE_DNS_RESOLVERS_VIEW=net_dns_resolvers_enabled
CLICKHOUSE_BMP_ROUTE_EVENTS_TABLE=bmp_route_events
CLICKHOUSE_L3_PREFIXES_TABLE=net_l3_prefixes
CLICKHOUSE_L3_PREFIXES_VIEW=net_l3_prefixes_enabled
CLICKHOUSE_FLOW_EXCLUSIONS_TABLE=net_flow_exclusions
CLICKHOUSE_FLOW_EXCLUSIONS_VIEW=net_flow_exclusions_enabled
CLICKHOUSE_ENTITIES_TABLE=net_entities
CLICKHOUSE_ENTITIES_VIEW=net_entities_enabled
CLICKHOUSE_PORT_SERVICES_TABLE=port_services
CLICKHOUSE_PORT_SERVICES_VIEW=port_services_enabled
CLICKHOUSE_PORT_SERVICES_EXPANDED_VIEW=port_services_expanded_enabled
CLICKHOUSE_USERS_TABLE=users
CLICKHOUSE_ROLES_TABLE=roles
CLICKHOUSE_ROLE_PERMISSIONS_TABLE=role_permissions
CLICKHOUSE_USER_PERMISSIONS_TABLE=user_permissions

CLICKHOUSE_REQUEST_TIMEOUT_MS=30000
# Зона данных и подписей графиков. Должна совпадать у UI и grapes-worker.
# Сервер ClickHouse у нас Europe/Moscow — не оставляйте UTC, иначе разбор/наблюдения съезжают на ±3 ч.
CLICKHOUSE_TIMEZONE=Europe/Moscow
# Логировать SQL в stdout (имя запроса, текст, params, время, ошибки)
# По умолчанию включено, если NODE_ENV !== production
CLICKHOUSE_LOG_SQL=true
# Подробные логи API, ClickHouse и экрана загрузки в браузере
# По умолчанию включено, если NODE_ENV !== production
LOG_VERBOSE=true

# Маппинг колонок таблицы потоков (схема Akvorado / NetFlow)
CH_COL_TIME=time_received_ns
CH_COL_BYTES=bytes
CH_COL_PACKETS=packets
CH_COL_SRC_IP=src_addr
CH_COL_DST_IP=dst_addr
CH_COL_SRC_PORT=src_port
CH_COL_DST_PORT=dst_port
CH_COL_PROTO=proto
CH_COL_SRC_ASN=src_asn
CH_COL_DST_ASN=dst_asn
# Доп. колонки flows_raw для recent-flows (пустое значение = не выбирать)
CH_COL_SOURCE_ID=source_id
CH_COL_DIRECTION=direction
CH_COL_ETYPE=etype
CH_COL_SRC_LABEL=src_label
CH_COL_DST_LABEL=dst_label
CH_COL_SRC_ENDPOINT_SCOPE=src_endpoint_scope
CH_COL_DST_ENDPOINT_SCOPE=dst_endpoint_scope
CH_COL_SRC_ENDPOINT_SOURCE=src_endpoint_source
CH_COL_DST_ENDPOINT_SOURCE=dst_endpoint_source
CH_COL_SRC_NETWORK_NAME=src_network_name
CH_COL_DST_NETWORK_NAME=dst_network_name
CH_COL_SRC_MAC=src_mac
CH_COL_DST_MAC=dst_mac
CH_COL_TCP_FLAGS=tcp_flags
# Тип хранения MAC в flows_raw: fixedstring (FixedString(6)) или uint64 (Akvorado SrcMAC/DstMAC)
CH_MAC_STORAGE=fixedstring
# Масштабирование sampled NetFlow/IPFIX в Explorer и на странице коллекторов
CH_COL_SAMPLING_RATE=sampling_rate
# CLICKHOUSE_COLLECTOR_HEALTH_VIEW=daemon_health_latest
CLICKHOUSE_COLLECTOR_HEALTH_SNAPSHOTS_TABLE=collector_health_snapshots

# Bounds-service (Python): чтение и запись config.yaml
# LOG_VERBOSE также управляет подробными логами bounds-service
BOUNDS_MODE=local
BOUNDS_SERVICE_URL=http://localhost:5001
BOUNDS_SERVICE_TOKEN=dev-bounds-token
# Путь к config.yaml (local: на этой машине; ssh: на удалённом сервере BOUNDS_SSH_HOST)
BOUNDS_CONFIG_PATH=./bounds-service/data/config.yaml
# Docker local: каталог на хосте с config.yaml (dirname от BOUNDS_CONFIG_PATH)
BOUNDS_LOCAL_DIR=./bounds-service/data
BOUNDS_UID=1000
BOUNDS_GID=1000
# Для BOUNDS_MODE=ssh:
# BOUNDS_SSH_HOST=5.188.236.0
# BOUNDS_CONFIG_PATH=/path/on/remote/server/config.yaml
# Запуск: docker compose -f docker-compose.yml -f docker-compose.bounds-ssh.yml up -d
# BOUNDS_SSH_PORT=22
# BOUNDS_SSH_USER=
# BOUNDS_SSH_PASSWORD=
# BOUNDS_SSH_PRIVATE_KEY=
# BOUNDS_SSH_CONNECT_TIMEOUT_MS=10000

# COMPLETENESS_WINDOW_MINUTES=5
# COMPLETENESS_LAG_MINUTES=2
# COMPLETENESS_ACK_OFFSET_MINUTES=5
# COMPLETENESS_WARN_BYTES_PCT=95
# COMPLETENESS_WARN_PACKETS_PCT=95
# COMPLETENESS_CRITICAL_BYTES_PCT=90
# COMPLETENESS_CRITICAL_PACKETS_PCT=90
# CH_COL_HEALTH_SOURCE_ID=source_id
# CH_COL_WRITER_LAG=writer_lag_sec
# CH_COL_SPOOL_LAG=spool_lag_sec
# CH_COL_QUEUE_DROPS=queue_drops

CLICKHOUSE_GEO_COUNTRY_DICT=default.geo_country_dict
