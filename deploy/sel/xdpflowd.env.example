# Copy to `/etc/xdpflowd/sel.env` on `sel` and fill secrets.
#
#   sudo mkdir -p /etc/xdpflowd
#   sudo cp deploy/sel/xdpflowd.env.example /etc/xdpflowd/sel.env
#   sudo chmod 0600 /etc/xdpflowd/sel.env
#   sudoedit /etc/xdpflowd/sel.env
#
# Required for ClickHouse direct ingest:
#   XDP_CH_DSN — native protocol, e.g. clickhouse://USER:PASS@HOST:9000/default
#   XDP_CH_TABLE — e.g. default.flows_raw
#
# Optional: if your checkout is not under /opt/GrapesNTA, set REPO_ROOT.

REPO_ROOT=/opt/GrapesNTA
XDPFLOWD_BIN=${REPO_ROOT}/bin/xdpflowd

IFACE=enp5s0d1
XDP_BPF_OBJ=${REPO_ROOT}/bpf/xdp_flow.o
XDP_MODE=generic
XDP_ACTION=drop

# When 1, UDP/53 always uses XDP_PASS on the SPAN interface so co-located
# dnsflowd (AF_PACKET) can capture DNS while other traffic stays -xdp-action drop.
XDP_DNS_PASSTHROUGH=0

# Local nfcapd only (no goflow2 fanout in permanent mode — goflow2 is stopped).
NF_DSTS=127.0.0.1:9996

# Tuned sel production profile: keep short export windows, but scan the map once
# per second. This preserved rx_fifo_errors=0/sec and reduced CPU vs 500ms scan.
XDP_HEAVY_EXPORT=0

# Explicit timeouts when XDP_HEAVY_EXPORT=0 (ignored if heavy=1).
XDP_NF_ACTIVE=60s
XDP_NF_IDLE=10s
XDP_NF_TEMPLATE_INTERVAL=60s
XDP_NF_SCAN=1s

XDP_TOP=0
XDP_INTERVAL=5s
# How often to walk the full BPF flow map for the top-N dump (expensive on
# high-cardinality hosts). Cheap PERCPU stats still print every XDP_INTERVAL.
# Set 0 to disable the top-N dump entirely and keep only the cheap stats line.
XDP_TOP_INTERVAL=60s
XDP_HEALTH_INTERVAL=1m
XDP_HEALTH_SPOOL_LAG_SEGMENTS=10
XDP_HEALTH_WRITER_LAG_ROWS=100000
XDP_HEALTH_DRAINER_AGE=2m

# JSON snapshots off by default (lower overhead).
XDP_JSON_OUT_ENABLE=0
XDP_JSON_OUT_PATH=
XDP_JSON_INTERVAL=10s

# Optional YAML merged before CLI (leave empty if unused).
XDP_CONFIG_FILE=

# ClickHouse — set DSN (URL-encode special chars in password) and table.
XDP_CH_DSN=
XDP_CH_TABLE=default.flows_raw
XDP_CH_BATCH_SIZE=500
XDP_CH_FLUSH_INTERVAL=1s
XDP_CH_QUEUE_SIZE=64
XDP_CH_SAMPLER_ADDR=127.0.0.1

# Logical observation point written to flows_raw.source_id (see net_flow_sources).
# XDPFLOWD_SOURCE_ID=xdp-core-mirror-1

# Collector-side traffic classification. Enable only after applying:
#   deploy/clickhouse/net_entities.sql
#   deploy/clickhouse/net_l3_prefixes.sql
#   deploy/clickhouse/net_l2_vlans.sql
#   deploy/clickhouse/flows_raw_extensions.sql
XDP_CLASSIFIER=0
XDP_CLASSIFIER_REFRESH=60s
XDP_CLASSIFIER_BGP_TABLE=default.bgp_prefix_origin_current
XDP_CLASSIFIER_L3_PREFIXES_VIEW=default.net_l3_prefixes_enabled
XDP_CLASSIFIER_L2_VLANS_VIEW=default.net_l2_vlans_enabled

XDP_CH_SPOOL_MODE=required
XDP_CH_SPOOL_DIR=/var/lib/xdpflowd/ch-spool
XDP_CH_SPOOL_SEGMENT_SIZE=268435456
XDP_CH_SPOOL_MAX_BYTES=214748364800
XDP_CH_SPOOL_FRAME_MAX_RECORDS=50000
XDP_CH_SPOOL_FSYNC_INTERVAL=1s
# Bounded drain on SIGTERM so systemd stop flushes spool (raise if maps are huge).
# Drain also aborts early if drainer makes no ack progress for STALL_THRESHOLD.
XDP_CH_SPOOL_SHUTDOWN_DRAIN=300s
# Force resync past suspect frame if the durable consumer makes no progress
# for this long while spool data is available (also caps shutdown drain wait).
XDP_CH_SPOOL_STALL_THRESHOLD=60s
XDP_CH_WRITERS=8

# Kept aligned with the validated wrapper profile; systemd mode does not run
# prod_ab_swap's watchdog, but this value documents the intended tolerance.
WATCHDOG_STALL_SEC=300

# goflow2 container stopped by prod_enable script (space-separated for rollback).
XDP_GOFLOW2_CONTAINERS=kcg-goflow2-1

# Optional: refuse to run unless `hostname -s` matches (e.g. sel).
# XDPFLOWD_EXPECT_HOST_SHORT=sel
