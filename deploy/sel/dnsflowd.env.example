# Copy to `/etc/dnsflowd/sel.env` on `sel`.
#
#   sudo mkdir -p /etc/dnsflowd
#   sudo cp deploy/sel/dnsflowd.env.example /etc/dnsflowd/sel.env
#   sudo chmod 0600 /etc/dnsflowd/sel.env
#   sudoedit /etc/dnsflowd/sel.env
#
# Requires xdpflowd with XDP_DNS_PASSTHROUGH=1 on the *same* IFACE so UDP/53
# reaches the kernel stack (AF_PACKET). Leave XDP_DNS_PASSTHROUGH=0 until dnsflowd is ready.

REPO_ROOT=/opt/GrapesNTA
DNSFLOWD_BIN=${REPO_ROOT}/bin/dnsflowd

# Must match the mirror interface used by xdpflowd on this host.
IFACE=enp4s0np0

DNS_CH_DSN=
DNS_CH_TABLE=default.dns_log
DNS_CH_BATCH_SIZE=500
DNS_CH_FLUSH_INTERVAL=1s
DNS_CH_QUEUE_SIZE=64
DNS_CH_SAMPLER_ADDR=127.0.0.1

DNS_INTERVAL=5s

# Optional: refuse to run unless `hostname -s` matches.
# DNSFLOWD_EXPECT_HOST_SHORT=sel
