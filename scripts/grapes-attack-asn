#!/usr/bin/env bash
# AS и сети /24 с начала атаки.
#
# На сервере, где крутится UI:
#   ./scripts/grapes-attack-asn
#   ./scripts/grapes-attack-asn --attack 'client:115628|2026-10-23 12:01:00'
#   ./scripts/grapes-attack-asn --attack 'client:115628|2026-10-23 12:01:00' --csv > attackers.csv
#
# Идентификатор берётся из списка без аргументов. В нём есть пробел, поэтому id в кавычках.
# Считается мусорный UDP к цели, тем же правилом, что блок в карточке атаки.
set -euo pipefail

if [[ -f /app/server/attack-asn.js ]]; then
  cd /app
  exec node server/attack-asn.js "$@"
fi

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
LOCAL="${ROOT}/deploy/ui/app"

if command -v docker >/dev/null 2>&1 \
  && docker exec -w /app grapes-nta test -f /app/server/attack-asn.js >/dev/null 2>&1
then
  exec docker exec -w /app grapes-nta node server/attack-asn.js "$@"
fi

if [[ -f "${LOCAL}/server/attack-asn.js" ]] && command -v node >/dev/null 2>&1; then
  cd "${LOCAL}"
  exec node server/attack-asn.js "$@"
fi

echo "Команда не найдена. На сервере UI: docker exec -w /app grapes-nta node server/attack-asn.js" >&2
exit 1
