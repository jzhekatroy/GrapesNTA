# Copy to /etc/grapesnta/snmp-iface-sync.env on the polling host.
# SNMP communities are intentionally not stored in this file. Configure the
# global default or per-switch override in ClickHouse through the admin UI.
#
# The polling host must reach:
#   1) ClickHouse (this DSN)
#   2) switch management IPs on UDP/161
# Avoid Docker bridge networks that overlap mgmt prefixes (e.g. 172.18.0.0/16).

SNMP_SYNC_CH_HOST=95.215.1.30
SNMP_SYNC_CH_PORT=6124
SNMP_SYNC_CH_USER=develop
SNMP_SYNC_CH_PASSWORD=
SNMP_SYNC_CH_DATABASE=default

# Optional binary paths.
# SNMP_SYNC_CLICKHOUSE_CLIENT=/usr/bin/clickhouse-client
# SNMP_SYNC_SNMPGET=/usr/bin/snmpget
# SNMP_SYNC_SNMPWALK=/usr/bin/snmpwalk

# Per-run safety limits. A backlog continues on the next one-minute tick.
# Keep MAX_AGENTS modest on first bring-up (full ifName walks are slow).
SNMP_SYNC_MAX_AGENTS=25
SNMP_SYNC_MAX_INTERFACES=4096

