# Install: sudo cp deploy/systemd/grapes-analytics.env.example /etc/grapesnta/grapes-analytics.env
# Prefer putting ClickHouse secrets in /opt/NTAdmin/.env and keep this file for worker knobs.

ANALYTICS_REPORT_CHECK_SEC=3600
OBSERVATION_ROLLUP_CONCURRENCY=1
OBSERVATION_ROLLUP_SHOT_MINUTES=15
GRAPES_ANALYTICS_WORKER=1
